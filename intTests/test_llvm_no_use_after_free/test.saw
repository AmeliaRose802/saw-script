enable_experimental;

m <- llvm_load_module "test.bc";

let i8    = llvm_int 8;
let i64   = llvm_int 64;
let i32   = llvm_int 32;

// Model model_alloc: returns either a valid pointer or null (nondeterministic)
let alloc_spec : CrucibleSetup () = do {
    size <- llvm_fresh_var "size" i64;
    
    llvm_execute_func [llvm_term size];
    
    // Nondeterministic: may return a valid pointer to allocated memory
    ret <- llvm_alloc (llvm_array 64 i8);
    llvm_return ret;
};

// Model model_alloc failing: returns null
let alloc_fail_spec : CrucibleSetup () = do {
    size <- llvm_fresh_var "size" i64;
    
    llvm_execute_func [llvm_term size];
    
    llvm_return (llvm_null);
};

// Model model_free: takes a pointer, no-op for verification
let free_spec : CrucibleSetup () = do {
    ptr <- llvm_alloc (llvm_array 64 i8);
    
    llvm_execute_func [ptr];
};

// ---- Test 1: key_buffer_free is safe on uninitialized buffer ----
let key_buffer_type = llvm_struct_type [llvm_type "i8*", i64, i8];

let free_uninit_spec : CrucibleSetup () = do {
    buf <- llvm_alloc key_buffer_type;
    // Buffer with is_allocated = 0 (not allocated)
    llvm_points_to buf (llvm_struct_value [
        llvm_null,
        llvm_term {{ 0 : [64] }},
        llvm_term {{ 0 : [8] }}
    ]);
    
    llvm_execute_func [buf];
    
    // Buffer unchanged (no free called, no crash)
    llvm_points_to buf (llvm_struct_value [
        llvm_null,
        llvm_term {{ 0 : [64] }},
        llvm_term {{ 0 : [8] }}
    ]);
};

free_uninit_ov <- llvm_verify m "key_buffer_free" [] false free_uninit_spec z3;
print "key_buffer_free on uninitialized: VERIFIED (no use-after-free)";

// ---- Test 2: process_with_cleanup when alloc fails ----
// Override alloc to fail (return null)
alloc_fail_ov <- llvm_unsafe_assume_spec m "model_alloc" alloc_fail_spec;

let process_fail_spec : CrucibleSetup () = do {
    size <- llvm_fresh_var "size" i64;
    
    llvm_execute_func [llvm_term size];
    
    // Returns -1 on allocation failure
    llvm_return (llvm_term {{ -1 : [32] }});
};

process_fail_ov <- llvm_verify m "process_with_cleanup" [alloc_fail_ov, free_uninit_ov] false process_fail_spec z3;
print "process_with_cleanup (alloc fails): VERIFIED (safe cleanup, no use-after-free)";

// ---- Test 3: process_with_cleanup when alloc succeeds ----
alloc_ok_ov <- llvm_unsafe_assume_spec m "model_alloc" alloc_spec;
free_ov <- llvm_unsafe_assume_spec m "model_free" free_spec;

let free_allocated_spec : CrucibleSetup () = do {
    buf <- llvm_alloc key_buffer_type;
    data_ptr <- llvm_alloc (llvm_array 64 i8);
    buf_len <- llvm_fresh_var "buf_len" i64;
    llvm_points_to buf (llvm_struct_value [
        data_ptr,
        llvm_term buf_len,
        llvm_term {{ 1 : [8] }}
    ]);
    
    llvm_execute_func [buf];
    
    // After free: data nulled, is_allocated = 0, len = 0
    llvm_points_to buf (llvm_struct_value [
        llvm_null,
        llvm_term {{ 0 : [64] }},
        llvm_term {{ 0 : [8] }}
    ]);
};

free_allocated_ov <- llvm_verify m "key_buffer_free" [free_ov] false free_allocated_spec z3;
print "key_buffer_free on allocated buffer: VERIFIED (proper cleanup)";

let process_ok_spec : CrucibleSetup () = do {
    size <- llvm_fresh_var "size" i64;
    
    llvm_execute_func [llvm_term size];
    
    // Returns 0 on success
    llvm_return (llvm_term {{ 0 : [32] }});
};

process_ok_ov <- llvm_verify m "process_with_cleanup" [alloc_ok_ov, free_allocated_ov] false process_ok_spec z3;
print "process_with_cleanup (alloc succeeds): VERIFIED (safe cleanup, no use-after-free)";

print "All use-after-free safety tests passed!";
