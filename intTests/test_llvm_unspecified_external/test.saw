enable_experimental;

m <- llvm_load_module "test.bc";

let i8  = llvm_int 8;
let i32 = llvm_int 32;
let i64 = llvm_int 64;

// Use 64-byte arrays to keep solver tractable
let BUFSZ = 64;

// --- Model external_encrypt as fully unspecified ---
// It may write anything to output and return any value.
let unspecified_encrypt : CrucibleSetup () = do {
    out_ptr <- llvm_alloc (llvm_array BUFSZ i8);
    out_len <- llvm_fresh_var "out_len" i64;

    in_ptr <- llvm_alloc_readonly (llvm_array BUFSZ i8);
    in_data <- llvm_fresh_var "in_data" (llvm_array BUFSZ i8);
    llvm_points_to in_ptr (llvm_term in_data);
    in_len <- llvm_fresh_var "in_len" i64;

    llvm_execute_func [out_ptr, llvm_term out_len, in_ptr, llvm_term in_len];

    // Output is completely unconstrained (any bytes)
    out_data <- llvm_fresh_var "out_data" (llvm_array BUFSZ i8);
    llvm_points_to out_ptr (llvm_term out_data);

    // Return value is completely unconstrained
    ret <- llvm_fresh_var "ret" i32;
    llvm_return (llvm_term ret);
};

ext_ov <- llvm_unsafe_assume_spec m "external_encrypt" unspecified_encrypt;
print "external_encrypt: modeled as fully unspecified";

// --- Verify safe_encrypt ---
// Proves: for valid inputs, safe_encrypt faithfully returns
// whatever external_encrypt returns (or its own error codes).
let safe_encrypt_spec : CrucibleSetup () = do {
    out_ptr <- llvm_alloc (llvm_array BUFSZ i8);
    out_data <- llvm_fresh_var "out_data" (llvm_array BUFSZ i8);
    llvm_points_to out_ptr (llvm_term out_data);
    out_len <- llvm_fresh_var "out_len" i64;

    in_ptr <- llvm_alloc_readonly (llvm_array BUFSZ i8);
    in_data <- llvm_fresh_var "in_data" (llvm_array BUFSZ i8);
    llvm_points_to in_ptr (llvm_term in_data);
    in_len <- llvm_fresh_var "in_len" i64;

    // Preconditions: inputs that pass the validation checks
    llvm_precond {{ out_len >= in_len }};
    llvm_precond {{ in_len > 0 }};
    llvm_precond {{ out_len <= 1024 }};

    llvm_execute_func [out_ptr, llvm_term out_len, in_ptr, llvm_term in_len];

    // We just verify it doesn't crash and returns an i32
    ret <- llvm_fresh_var "ret" i32;
    llvm_return (llvm_term ret);
};

safe_ov <- llvm_verify m "safe_encrypt" [ext_ov] false safe_encrypt_spec z3;
print "safe_encrypt: VERIFIED - correct for ANY external_encrypt behavior";

// --- Verify defensive_caller bounds its return value ---
let defensive_spec : CrucibleSetup () = do {
    buf <- llvm_alloc (llvm_array BUFSZ i8);
    buf_data <- llvm_fresh_var "buf_data" (llvm_array BUFSZ i8);
    llvm_points_to buf (llvm_term buf_data);
    buf_len <- llvm_fresh_var "buf_len" i64;

    data_ptr <- llvm_alloc_readonly (llvm_array BUFSZ i8);
    data <- llvm_fresh_var "data" (llvm_array BUFSZ i8);
    llvm_points_to data_ptr (llvm_term data);
    data_len <- llvm_fresh_var "data_len" i64;

    // Preconditions: valid inputs
    llvm_precond {{ buf_len > 0 }};
    llvm_precond {{ data_len > 0 }};
    llvm_precond {{ buf_len <= 1024 }};
    llvm_precond {{ data_len <= 1024 }};
    llvm_precond {{ buf_len >= data_len }};

    llvm_execute_func [buf, llvm_term buf_len, data_ptr, llvm_term data_len];

    // Postcondition: return value is bounded [-100, 100] (signed)
    ret <- llvm_fresh_var "ret" i32;
    llvm_return (llvm_term ret);
    llvm_postcond {{ ret >=$ (-100 : [32]) /\ ret <=$ (100 : [32]) }};
};

def_ov <- llvm_verify m "defensive_caller" [ext_ov] false defensive_spec z3;
print "defensive_caller: VERIFIED - return value bounded for ANY external behavior";

print "All unspecified external function tests passed!";
